+static uint32_t esp32s3_ps_get_TIOCM(void)
+{
+    ESP32UARTState *s = ESP32_UART(&global_ss->uart[0]);
+    uint32_t state = 0;
+    qemu_chr_fe_ioctl(&s->chr, CHR_IOCTL_SERIAL_GET_TIOCM, &state);
