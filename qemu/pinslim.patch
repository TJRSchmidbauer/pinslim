+static void esp32s3_ps_set_pin(int pin, int value)
+{
+    if (pin < 0 || pin >= (int)ARRAY_SIZE(pin_irq) || !pin_irq[pin]) {
+        return;
+    }
+    if (value) {
+        qemu_irq_raise(pin_irq[pin]);
+    } else {
+        qemu_irq_lower(pin_irq[pin]);
+    }
+}
+
+static void esp32s3_ps_set_apin(int chn, int value)
+{
+    if (chn >= 0 && chn < ESP32S3_SENS_ADC_CHANNELS) {
+        global_ss->sens.ADC_values[chn] = value;
+    }
+}
