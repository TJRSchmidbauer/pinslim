diff --git a/hw/gpio/esp32s3_gpio.c b/hw/gpio/esp32s3_gpio.c
index 0a0e4774..d539a79e 100644
--- a/hw/gpio/esp32s3_gpio.c
+++ b/hw/gpio/esp32s3_gpio.c
@@ -1,7 +1,12 @@
 /*
  * ESP32-S3 GPIO emulation
  *
+ * Register layout per ESP-IDF soc/esp32s3/register/soc/gpio_reg.h: two banks
+ * (GPIO0-31 and GPIO32-48), GPIO_PINn at 0x74, function input select at
+ * 0x154 and output select at 0x554. See esp32s3_gpio.h.
+ *
  * Copyright (c) 2023 Espressif Systems (Shanghai) Co. Ltd.
+ * Copyright (c) 2026 Pinslim contributors
  *
  * This program is free software; you can redistribute it and/or modify
  * it under the terms of the GNU General Public License version 2 or
@@ -19,22 +24,238 @@
 #include "hw/qdev-properties.h"
 #include "hw/gpio/esp32s3_gpio.h"
 
+#define A_OUT            0x04
+#define A_OUT_W1TS       0x08
+#define A_OUT_W1TC       0x0C
+#define A_OUT1           0x10
+#define A_OUT1_W1TS      0x14
+#define A_OUT1_W1TC      0x18
+#define A_ENABLE         0x20
+#define A_ENABLE_W1TS    0x24
+#define A_ENABLE_W1TC    0x28
+#define A_ENABLE1        0x2C
+#define A_ENABLE1_W1TS   0x30
+#define A_ENABLE1_W1TC   0x34
+#define A_STRAP          0x38
+#define A_IN             0x3C
+#define A_IN1            0x40
+#define A_STATUS         0x44
+#define A_STATUS_W1TS    0x48
+#define A_STATUS_W1TC    0x4C
+#define A_STATUS1        0x50
+#define A_STATUS1_W1TS   0x54
+#define A_STATUS1_W1TC   0x58
+#define A_PCPU_INT       0x5C
+#define A_PCPU_INT1      0x68
+#define A_PIN0           0x74
+#define A_FUNC0_IN_SEL   0x154
+#define A_FUNC0_OUT_SEL  0x554
+
+/* Bank 1 only has GPIO32-48 */
+#define BANK1_MASK ((1u << (ESP32S3_GPIO_COUNT - 32)) - 1)
+
+/* GPIO_PINn: INT_TYPE [9:7], INT_ENA [17:13] (bit 13 = CPU0 interrupt) */
+#define PIN_INT_TYPE(v)   (((v) >> 7) & 7)
+#define PIN_INT_CPU0      (1u << 13)
+
+static uint32_t bank_mask(int bank)
+{
+    return bank ? BANK1_MASK : 0xFFFFFFFFu;
+}
+
+static uint64_t esp32s3_gpio_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+
+    switch (addr) {
+    case A_OUT:      return s->out[0];
+    case A_OUT1:     return s->out[1];
+    case A_ENABLE:   return s->enable[0];
+    case A_ENABLE1:  return s->enable[1];
+    case A_STRAP:    return s->strap_mode;
+    case A_IN:
+        qemu_set_irq(s->gpios_sync[0], -1); /* ask the host to push levels */
+        return s->in[0];
+    case A_IN1:
+        qemu_set_irq(s->gpios_sync[0], -1);
+        return s->in[1];
+    case A_STATUS:   return s->status[0];
+    case A_STATUS1:  return s->status[1];
+    case A_PCPU_INT: return s->pcpu_int[0];
+    case A_PCPU_INT1: return s->pcpu_int[1];
+    default:
+        break;
+    }
+    if (addr >= A_PIN0 && addr < A_PIN0 + 4 * ESP32S3_GPIO_COUNT) {
+        return s->pin[(addr - A_PIN0) / 4];
+    }
+    if (addr >= A_FUNC0_IN_SEL && addr < A_FUNC0_IN_SEL + 4 * ESP32S3_GPIO_IN_SIGNALS) {
+        return s->in_sel[(addr - A_FUNC0_IN_SEL) / 4];
+    }
+    if (addr >= A_FUNC0_OUT_SEL && addr < A_FUNC0_OUT_SEL + 4 * ESP32S3_GPIO_COUNT) {
+        return s->out_sel[(addr - A_FUNC0_OUT_SEL) / 4];
+    }
+    return 0;
+}
+
+static int get_triggering(int int_type, int oldval, int val)
+{
+    switch (int_type) {
+    case 1: return val > oldval;   /* rising edge */
+    case 2: return val < oldval;   /* falling edge */
+    case 3: return val != oldval;  /* any edge */
+    case 4: return val == 0;       /* low level */
+    case 5: return val == 1;       /* high level */
+    }
+    return 0;
+}
+
+/* External level driven into pin n by the host. */
+static void set_gpio(void *opaque, int n, int val)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+    if (n < 0 || n >= ESP32S3_GPIO_COUNT) {
+        return;
+    }
+    int bank = n / 32, bit = n % 32;
+    int oldval = (s->in[bank] >> bit) & 1;
+    val = val ? 1 : 0;
+    s->in[bank] = (s->in[bank] & ~(1u << bit)) | ((uint32_t)val << bit);
+
+    if (get_triggering(PIN_INT_TYPE(s->pin[n]), oldval, val) &&
+        (s->pin[n] & PIN_INT_CPU0)) {
+        s->status[bank] |= 1u << bit;
+        s->pcpu_int[bank] |= 1u << bit;
+        qemu_set_irq(s->irq, 1);
+    }
+}
+
+/* Level interrupts stay pending while their condition holds. */
+static void clear_status(ESP32S3GPIOState *s, int bank, uint32_t value)
+{
+    for (int i = 0; i < 32; i++) {
+        int n = bank * 32 + i;
+        if (!((1u << i) & value) || n >= ESP32S3_GPIO_COUNT) {
+            continue;
+        }
+        int t = PIN_INT_TYPE(s->pin[n]);
+        int level = (s->in[bank] >> i) & 1;
+        if ((t == 4 && !level) || (t == 5 && level)) {
+            value &= ~(1u << i);
+        }
+    }
+    s->status[bank] &= ~value;
+    s->pcpu_int[bank] &= ~value;
+    if (!(s->pcpu_int[0] | s->pcpu_int[1])) {
+        qemu_set_irq(s->irq, 0);
+    }
+}
+
+static void esp32s3_gpio_write(void *opaque, hwaddr addr, uint64_t value,
+                               unsigned int size)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(opaque);
+    uint32_t old_out[2] = { s->out[0], s->out[1] };
+    uint32_t old_en[2] = { s->enable[0], s->enable[1] };
+    uint32_t v = (uint32_t)value;
+
+    switch (addr) {
+    case A_OUT:          s->out[0] = v; break;
+    case A_OUT_W1TS:     s->out[0] |= v; break;
+    case A_OUT_W1TC:     s->out[0] &= ~v; break;
+    case A_OUT1:         s->out[1] = v & BANK1_MASK; break;
+    case A_OUT1_W1TS:    s->out[1] |= v & BANK1_MASK; break;
+    case A_OUT1_W1TC:    s->out[1] &= ~v; break;
+    case A_ENABLE:       s->enable[0] = v; break;
+    case A_ENABLE_W1TS:  s->enable[0] |= v; break;
+    case A_ENABLE_W1TC:  s->enable[0] &= ~v; break;
+    case A_ENABLE1:      s->enable[1] = v & BANK1_MASK; break;
+    case A_ENABLE1_W1TS: s->enable[1] |= v & BANK1_MASK; break;
+    case A_ENABLE1_W1TC: s->enable[1] &= ~v; break;
+    case A_STRAP:        s->strap_mode = v; break;
+    case A_STATUS:       s->status[0] = v; break;
+    case A_STATUS_W1TS:  s->status[0] |= v; break;
+    case A_STATUS_W1TC:  clear_status(s, 0, v); break;
+    case A_STATUS1:      s->status[1] = v & BANK1_MASK; break;
+    case A_STATUS1_W1TS: s->status[1] |= v & BANK1_MASK; break;
+    case A_STATUS1_W1TC: clear_status(s, 1, v); break;
+    default:
+        break;
+    }
+
+    if (addr >= A_PIN0 && addr < A_PIN0 + 4 * ESP32S3_GPIO_COUNT) {
+        s->pin[(addr - A_PIN0) / 4] = v;
+    } else if (addr >= A_FUNC0_IN_SEL &&
+               addr < A_FUNC0_IN_SEL + 4 * ESP32S3_GPIO_IN_SIGNALS) {
+        int n = (addr - A_FUNC0_IN_SEL) / 4;
+        s->in_sel[n] = v;
+        qemu_set_irq(s->gpios_sync[0], 0x1000 | n);   /* in-select changed */
+    } else if (addr >= A_FUNC0_OUT_SEL &&
+               addr < A_FUNC0_OUT_SEL + 4 * ESP32S3_GPIO_COUNT) {
+        int n = (addr - A_FUNC0_OUT_SEL) / 4;
+        s->out_sel[n] = v;
+        qemu_set_irq(s->gpios_sync[0], 0x2000 | n);   /* out-select changed */
+    }
+
+    for (int bank = 0; bank < 2; bank++) {
+        uint32_t changed = ((s->out[bank] ^ old_out[bank]) |
+                            (s->enable[bank] ^ old_en[bank])) & bank_mask(bank);
+        uint32_t en_changed = (s->enable[bank] ^ old_en[bank]) & bank_mask(bank);
+        for (int i = 0; i < 32; i++) {
+            int n = bank * 32 + i;
+            if (n >= ESP32S3_GPIO_COUNT) {
+                break;
+            }
+            uint32_t bit = 1u << i;
+            if ((changed & bit) && (s->enable[bank] & bit)) {
+                int level = (s->out[bank] & bit) ? 1 : 0;
+                qemu_set_irq(s->gpios[n], level);
+                /* An output pin reads back what it drives. */
+                s->in[bank] = (s->in[bank] & ~bit) | (level ? bit : 0);
+            }
+            if (en_changed & bit) {
+                qemu_set_irq(s->gpios_dir[n], (s->enable[bank] & bit) ? 1 : 0);
+            }
+        }
+    }
+}
+
+static const MemoryRegionOps esp32s3_gpio_ops = {
+    .read = esp32s3_gpio_read,
+    .write = esp32s3_gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
 
 static void esp32s3_gpio_init(Object *obj)
 {
-    /* Set the default value for the property */
-    object_property_set_int(obj, "strap_mode", ESP32S3_STRAP_MODE_FLASH_BOOT, &error_fatal);
+    ESP32S3GPIOState *s = ESP32S3_GPIO(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32s3_gpio_ops, s,
+                          TYPE_ESP32S3_GPIO, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    qdev_init_gpio_out_named(DEVICE(s), s->gpios, ESP32_GPIOS, ESP32S3_GPIO_COUNT);
+    qdev_init_gpio_out_named(DEVICE(s), s->gpios_dir, ESP32_GPIOS_DIR, ESP32S3_GPIO_COUNT);
+    qdev_init_gpio_out_named(DEVICE(s), s->gpios_sync, ESP32_GPIOS_SYNC, 1);
+    qdev_init_gpio_in_named(DEVICE(s), set_gpio, ESP32_GPIOS_IN, ESP32S3_GPIO_COUNT);
+
+    s->strap_mode = ESP32S3_STRAP_MODE_FLASH_BOOT;
+    /* FUNCn_OUT_SEL resets to SIG_GPIO_OUT_IDX (256, plain GPIO output). */
+    for (int i = 0; i < ESP32S3_GPIO_COUNT; i++) {
+        s->out_sel[i] = 0x100;
+    }
+    /* Idle levels with the chip's default pull-ups (GPIO0 boot strap high). */
+    s->in[0] = 0x1;
 }
 
