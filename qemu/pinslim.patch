diff --git a/include/hw/misc/esp32s3_sens.h b/include/hw/misc/esp32s3_sens.h
new file mode 100644
index 00000000..c290b531
--- /dev/null
+++ b/include/hw/misc/esp32s3_sens.h
@@ -0,0 +1,28 @@
+/*
+ * ESP32-S3 SENS (RTC SAR ADC controller) — one-shot conversions only.
+ *
+ * ESP-IDF's oneshot driver on the S3 runs both ADC units from the RTC
+ * controller: pick the pad in SAR_MEASn_CTRL2.sarN_en_pad, pulse
+ * measN_start_sar, poll measN_done_sar, read measN_data_sar. The converted
+ * value is whatever the host injected for that channel (raw, 0-4095).
+ *
+ * Host channel numbering: 0-9 = ADC1 CH0-9 (GPIO1-10),
+ *                         10-19 = ADC2 CH0-9 (GPIO11-20).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+
+#define TYPE_ESP32S3_SENS "misc.esp32s3.sens"
+#define ESP32S3_SENS(obj) OBJECT_CHECK(Esp32s3SensState, (obj), TYPE_ESP32S3_SENS)
+
+#define ESP32S3_SENS_ADC_CHANNELS 20
+
+typedef struct Esp32s3SensState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t regs[0x400 / 4];
+    uint16_t ADC_values[ESP32S3_SENS_ADC_CHANNELS];
+} Esp32s3SensState;
diff --git a/include/hw/misc/picsimlab_api.h b/include/hw/misc/picsimlab_api.h
new file mode 100644
index 00000000..704d7ef6
--- /dev/null
+++ b/include/hw/misc/picsimlab_api.h
@@ -0,0 +1,50 @@
+/*
+ * PICSimLab host interface shared by every "*-picsimlab" machine.
+ *
+ * The host (PICSimLab, Pinslim's Python worker) loads libqemu-<arch>.so and
+ * drives the guest through the exported qemu_picsimlab_* functions. One
+ * library carries several machines (esp32 + esp32s3, esp32c3 + esp32c6), so
+ * the exported entry points live here once and forward to the machine that
+ * was actually instantiated, which registers its implementation from its
+ * machine_init.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_MISC_PICSIMLAB_API_H
+#define HW_MISC_PICSIMLAB_API_H
+
+#include <stdint.h>
+
+/* Host callbacks (set by qemu_picsimlab_register_callbacks). */
+extern void (*picsimlab_write_pin)(int pin, int value);
+extern void (*picsimlab_dir_pin)(int pin, int value);
+extern int (*picsimlab_i2c_event)(const uint8_t id, const uint8_t addr, const uint16_t event);
+extern uint8_t (*picsimlab_spi_event)(const uint8_t id, const uint16_t event);
+extern void (*picsimlab_uart_tx_event)(const uint8_t id, const uint8_t value);
+extern void (*picsimlab_rmt_event)(const uint8_t channel, const uint32_t config0, const uint32_t value);
+
+/* Host pin numbering: pinmap[0] = count, pinmap[1..] = guest GPIO (or -1). */
+extern const short int *picsimlab_pinmap;
+
+typedef struct PicsimlabMachineOps {
+    void (*set_pin)(int pin, int value);
+    void (*set_apin)(int chn, int value);
+    uint32_t *(*get_internals)(int cfg);
+    uint32_t (*get_TIOCM)(void);
+    int (*flash_dump)(int64_t offset, void *buf, int bytes);
+    void (*uart_receive)(const int id, const uint8_t *buf, int size);
+} PicsimlabMachineOps;
+
+/* Called by a picsimlab machine's init; the ops must outlive the machine. */
+void picsimlab_register_machine(const PicsimlabMachineOps *ops);
+
+/* Exported entry points (resolved by the host with dlsym). */
+void qemu_picsimlab_register_callbacks(void *arg);
+void qemu_picsimlab_set_pin(int pin, int value);
+void qemu_picsimlab_set_apin(int chn, int value);
+uint32_t *qemu_picsimlab_get_internals(int cfg);
+uint32_t qemu_picsimlab_get_TIOCM(void);
+int qemu_picsimlab_flash_dump(int64_t offset, void *buf, int bytes);
+void qemu_picsimlab_uart_receive(const int id, const uint8_t *buf, int size);
+
+#endif
