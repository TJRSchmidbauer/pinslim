diff --git a/hw/misc/esp32s3_sens.c b/hw/misc/esp32s3_sens.c
new file mode 100644
index 00000000..61e9de6b
--- /dev/null
+++ b/hw/misc/esp32s3_sens.c
@@ -0,0 +1,99 @@
+/*
+ * ESP32-S3 SENS (RTC SAR ADC controller) — one-shot conversions only.
+ * See include/hw/misc/esp32s3_sens.h.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32s3_sens.h"
+
+#define A_SAR_MEAS1_CTRL2  0x0C
+#define A_SAR_MEAS2_CTRL2  0x30
+
+/* SAR_MEASn_CTRL2 fields (soc/esp32s3/.../sens_struct.h) */
+#define MEAS_DATA_MASK     0xFFFFu
+#define MEAS_DONE          (1u << 16)
+#define MEAS_START         (1u << 17)
+#define EN_PAD_SHIFT       19
+#define EN_PAD_MASK        0xFFFu
+
+#define SAR_TSENS_CTRL 0x50     /* SENS_SAR_TSENS_CTRL_REG */
+#define TSENS_READY    (1u << 8)
+
+static uint64_t esp32s3_sens_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32s3SensState *s = ESP32S3_SENS(opaque);
+    if ((addr & 0x3FF) == SAR_TSENS_CTRL) {
+        /* Temperature sensor: always ready, TSENS_OUT[7:0] ≈ 25 °C. The
+         * WiFi PHY calibration polls TSENS_READY and spins forever on 0. */
+        return (s->regs[SAR_TSENS_CTRL / 4] & ~0x1FFu) | TSENS_READY | 0x80;
+    }
+    return s->regs[(addr & 0x3FF) / 4];
+}
+
+static void convert(Esp32s3SensState *s, hwaddr addr, int base_channel)
+{
+    uint32_t v = s->regs[addr / 4];
+    uint32_t pads = (v >> EN_PAD_SHIFT) & EN_PAD_MASK;
+    uint32_t data = 0;
+    if (pads) {
+        int ch = ctz32(pads);
+        if (base_channel + ch < ESP32S3_SENS_ADC_CHANNELS) {
+            data = s->ADC_values[base_channel + ch];
+        }
+    }
+    /* Conversion is instantaneous: data + done are visible on the next read. */
+    s->regs[addr / 4] = (v & ~MEAS_DATA_MASK) | (data & MEAS_DATA_MASK) | MEAS_DONE;
+}
+
+static void esp32s3_sens_write(void *opaque, hwaddr addr, uint64_t value,
+                               unsigned int size)
+{
+    Esp32s3SensState *s = ESP32S3_SENS(opaque);
+    addr &= 0x3FF;
+    uint32_t old = s->regs[addr / 4];
+    uint32_t v = (uint32_t)value;
+
+    if (addr == A_SAR_MEAS1_CTRL2 || addr == A_SAR_MEAS2_CTRL2) {
+        /* data/done are read-only; a new start clears done until converted */
+        v = (v & ~(MEAS_DATA_MASK | MEAS_DONE)) | (old & (MEAS_DATA_MASK | MEAS_DONE));
+        s->regs[addr / 4] = v;
+        if ((v & MEAS_START) && !(old & MEAS_START)) {
+            convert(s, addr, addr == A_SAR_MEAS1_CTRL2 ? 0 : 10);
+        } else if (!(v & MEAS_START)) {
+            s->regs[addr / 4] &= ~MEAS_DONE;
+        }
+        return;
+    }
+    s->regs[addr / 4] = v;
+}
+
+static const MemoryRegionOps esp32s3_sens_ops = {
+    .read = esp32s3_sens_read,
+    .write = esp32s3_sens_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32s3_sens_init(Object *obj)
+{
+    Esp32s3SensState *s = ESP32S3_SENS(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32s3_sens_ops, s,
+                          TYPE_ESP32S3_SENS, 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static const TypeInfo esp32s3_sens_info = {
+    .name = TYPE_ESP32S3_SENS,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32s3SensState),
+    .instance_init = esp32s3_sens_init,
+};
+
+static void esp32s3_sens_register_types(void)
+{
+    type_register_static(&esp32s3_sens_info);
+}
+
+type_init(esp32s3_sens_register_types)
