+    ESP32S3SysTimerState systimer;
+
+    ESP32C3UsbJtagState jtag;
+    ESPRgbState rgb;
+
+    MemoryRegion iomem;
+    DWCSDMMCState sdmmc;
+    DeviceState *eth;
+    SsiPsramState *psram;
+
+    uint32_t requested_reset;
+
+    /* PICSimLab additions */
+    Esp32C3IomuxState iomux;     /* same per-pin layout as the C3, 49 pads */
+    Esp32C3LEDCState ledc;       /* same layout as the C3 (channels 0-5) */
+    Esp32s3SensState sens;       /* RTC SAR ADC, one-shot */
+    Esp32I2CState i2c;
+    /* WiFi: the S3 MAC is the C3 one (same generation, same addresses) */
+    Esp32WifiState wifi;
+    Esp32C3AnaState ana;
+    Esp32PhyaState phya;
+    Esp32FeState fe;
+} Esp32s3SocState;
+
+
+/* Temporary macro to mark the CPU as in non-debugging mode */
+#define A_ASSIST_DEBUG_CORE_0_DEBUG_MODE_REG    0x098
