+static int esp32s3_ps_flash_dump(int64_t offset, void *buf, int bytes)
+{
+    if (global_ss->cache.flash_blk) {
+        return blk_pread(global_ss->cache.flash_blk, offset, bytes, buf, 0);
+    }
+    return 0;
+}
